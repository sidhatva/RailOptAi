# ─── RailOpt AI Backend — Environment Variables ──────────────────────────────
# Copy this file to backend/.env (or set these as system environment variables)
# NEVER commit .env to Git

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/railopt
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
